# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# PostgreSQL Database Connection
# Example for Neon serverless PostgreSQL: postgresql://username:password@ep-cool-sample.region.neon.tech/neondb?sslmode=require
# Example for local PostgreSQL: postgresql://postgres:postgres@localhost:5432/piggypocket
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/piggypocket

# JWT Secret Keys
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_here_change_in_production
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_here_change_in_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Email OTP Provider - Resend (Free Tier: 100 emails/day, 3,000/month)
# Get your free key at: https://resend.com
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Phone SMS OTP Provider - Twilio (Free Trial: $15 credit)
# Get credentials at: https://twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=

# India SMS Alternative - Fast2SMS (Free trial wallet)
# https://fast2sms.com
FAST2SMS_API_KEY=

# When API keys above are blank, OTP will be printed directly to the server terminal console for development.

