# ====================================================
# PIGGYPOCKET SERVER CONFIGURATION
# ====================================================
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Optional PostgreSQL Connection String (if omitted, file-backed database server/data/piggypocket_db.json is used)
DATABASE_URL=

# JWT Secrets for Production Authentication
JWT_ACCESS_SECRET=your_jwt_access_secret_change_in_production
JWT_REFRESH_SECRET=your_jwt_refresh_secret_change_in_production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ====================================================
# REAL EMAIL & OTP DISPATCH CONFIGURATION
# ====================================================
# Option A: Nodemailer SMTP (Recommended - Gmail, Brevo, Outlook)
# For Gmail:
# 1. Enable 2-Step Verification in your Google Account (Security tab)
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Create an App Password for "PiggyPocket"
# 4. Fill in your Gmail address and 16-character password below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Option B: Resend API (Free 100 emails/day at https://resend.com)
RESEND_API_KEY=

# SMS Providers (Optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
FAST2SMS_API_KEY=
