# Server Configuration
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# Web Frontend URL for CORS
WEB_URL=http://localhost:5173

# Database Connection (Docker local or free Neon Postgres)
# Local Docker: postgresql://budget_user:budget_password@localhost:5432/smart_budget_dev
# Neon / Cloud: postgresql://user:password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://budget_user:budget_password@localhost:5432/smart_budget_dev

# JWT / Auth Secret (Minimum 32 characters in production)
JWT_SECRET=super_secret_jwt_key_for_dev_min_32_characters_long

# Email Service (Brevo / Resend - to be selected later)
EMAIL_PROVIDER=brevo
EMAIL_API_KEY=test_api_key_placeholder
EMAIL_FROM=noreply@smartbudget.app
